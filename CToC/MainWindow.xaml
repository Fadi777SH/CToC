<Window x:Class="CToC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CToC"
        mc:Ignorable="d"
        Title="MainWindow"  Height="300" Width="400" Background="White">
    <Grid>

        <Grid Width="400" Height="300">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ToggleButton Grid.Column="1"  Width="50" Height="20" Name="btn" Background="Red" Click="btn_Click" />

            <Ellipse Width="10" Height="10" Grid.Column="0"  Fill="Gray" Focusable="False" Margin="0,0,115,260"/>
            <TextBlock Width="98" Height="20" Text="connection state : " Margin="0,0,0,260" />
            <TextBlock Name="ConnectionState" Width="10" Height="20" Text="F" Margin="110,0,0,260"  />
        </Grid>

    </Grid>
</Window>
