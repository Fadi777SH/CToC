<Window x:Class="SMR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CToC"
        xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
        mc:Ignorable="d"
        Title="SuperMassiveRemote" 
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyDown"
        ResizeMode="CanResize"
        MouseDown="Window_MouseDown"
        Width="1200" Height="600" Background="#FF201D1D">
    <Window.Resources>
        <Style TargetType="ToggleButton" x:Key="ToggelBtnStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bord" Width="40" Height="40" BorderThickness="2" BorderBrush="Red" Background="#FF6A1F1F" CornerRadius="10">
                            <TextBlock x:Name="text" Foreground="White" Text="Off" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Border.Effect>
                                <DropShadowEffect Opacity="1" ShadowDepth="1"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bord" Property="Background" Value="Black"/>
                                <Setter TargetName="bord" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="text" Property="Text" Value="On"/>
                                <Setter TargetName="bord" Property="Background" Value="#FF6A1F1F"/>
                                <Setter TargetName="bord" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Height="600" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*"/>
                <ColumnDefinition Name="PC2Grid" Width="0.8*" Focusable="True"/>
                <ColumnDefinition Width="0.1*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Background="Transparent" VerticalAlignment="Stretch" />
            <Border Grid.Column="2" Background="Transparent" VerticalAlignment="Stretch" />
            
            
            <Border Grid.Column="1"   Name="PC2Fram" 
                    MouseMove="PC2Fram_MouseMove"
                    MouseDown="PC2Fram_MouseDown"
                    MouseUp="PC2Fram_MouseUp"
                    MouseWheel="PC2Fram_MouseWheel"
                    Focusable="True"
                    Background="#FF430505"  >
                <Image Name="Frames" Stretch="Fill"  />
            </Border>


            <ToggleButton Focusable="False"  Grid.Column="2" Name="PC2ToPC1" Style="{StaticResource ToggelBtnStyle}" Click="ConnectToRemoteBtn"/>
            <ToggleButton Focusable="False"  Grid.Column="0" Name="PC1ToPC2" Style="{StaticResource ToggelBtnStyle}" Click="ConnectToWantedDeviceBtn"/>

            <TextBlock Foreground="White" Grid.Column="0" Height="20" Focusable="False" Margin="0,25,0,255" HorizontalAlignment="Center" Text="Your IP Address" FontFamily="Ebrima" />
            <TextBlock Foreground="White" Grid.Column="2" Height="20" Focusable="False" Margin="0,25,0,255" HorizontalAlignment="Center" Text="Your IP Address" FontFamily="Ebrima" />
            <TextBlock Foreground="White" Grid.Column="2" Height="20" Focusable="False" Margin="0,25,0,220" HorizontalAlignment="Center" Text="{Binding _IPAddress}" FontFamily="Ebrima" />
            <TextBlock Foreground="White" Grid.Column="0" Height="20" Focusable="False" Margin="0,25,0,220" HorizontalAlignment="Center" Text="{Binding _IPAddress}" FontFamily="Ebrima" />

            <TextBlock Foreground="White" Grid.Column="0" Height="20" Focusable="False" Margin="0,25,0,180" HorizontalAlignment="Center" Text="Second PC IP" FontFamily="Ebrima" />
            <TextBlock Foreground="White" Grid.Column="2" Height="20" Focusable="False" Margin="0,25,0,180" HorizontalAlignment="Center" Text="Second PC IP" FontFamily="Ebrima" />

            <TextBox   Grid.Column="2" Name="IPofRemote" Height="20" Width="100" Margin="0,25,0,140" HorizontalAlignment="Center" Text="192.168.100.74" FontFamily="Ebrima" TextChanged="IPofRemote_TextChanged" />
            <TextBox   Grid.Column="0" Name="IPOfWantedDevice" Height="20" Width="100"   Margin="0,25,0,140" HorizontalAlignment="Center" Text="192.168.100.74" FontFamily="Ebrima" TextChanged="IPOfWantedDevice_TextChanged"  />

            <TextBlock Foreground="White" Focusable="False" 
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft Sans Serif" Text="connect to remote"
                       Grid.Column="0"  Margin="10,100,0,0"/>
            <TextBlock Foreground="White" Margin="0,100,0,0" Focusable="False" FontFamily="Microsoft Sans Serif" Text="being the remote" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center" />
        </Grid>
    </Grid>
</Window>